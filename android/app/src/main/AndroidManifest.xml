<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- microfono: «Registra e confronta», oscilloscopio dei toni e riconoscimento vocale -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- La WebView (Chromium) lo usa per aprire la sorgente audio di getUserMedia (AudioManager.setMode per la «modalità comunicazione»). Senza,
         l'apertura fallisce con NotReadableError «Could not start audio source» anche col microfono concesso. Permesso normale: nessuna richiesta all'utente. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- fotocamera: solo per leggere i QR quando si passano i progressi da un telefono all'altro -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- vibrazione al tocco (si spegne nelle impostazioni dell'app) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- promemoria giornaliero, solo se acceso in Impostazioni (il permesso si chiede in quel momento, non all'avvio) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- musica con lo schermo spento, solo se scelta nel pannello musica -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- solo per la voce di riserva online e i link esterni: l'app funziona senza rete -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- per sapere se c'è un motore di sintesi e di riconoscimento vocale (Android 11+) -->
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <!-- Pleco (facoltativo, Impostazioni → Studio): per aprire una parola nel dizionario, se installato -->
        <package android:name="com.pleco.chinesesystem" />
        <!-- servizi vocali: solo per mostrare nell'autodiagnosi chi fa il riconoscimento vocale (nessun dato lascia il telefono) -->
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.google.android.tts" />
        <package android:name="com.miui.voiceassist" />
        <package android:name="com.xiaomi.mibrain.speech" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- scorciatoie (pressione prolungata sull'icona) -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- widget «Oggi» (4×2 e 2×1): i dati li manda la pagina con MandarinoAndroid.setWidgetState -->
        <receiver android:name=".TodayWidget" android:exported="true" android:label="@string/w_large_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_large_info" />
        </receiver>
        <receiver android:name=".TodayWidgetSmall" android:exported="true" android:label="@string/w_small_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_small_info" />
        </receiver>

        <!-- widget «Pausa» (4×1): giri da 25 minuti e pausa da 5, con il conto alla rovescia che scorre da solo (Chronometer) -->
        <receiver android:name=".PauseWidget" android:exported="true" android:label="@string/p_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_pause_info" />
        </receiver>

        <!-- widget «Ripasso rapido (piccolo)» (2×1): il numero di carte da ripassare adesso; un tocco apre il ripasso -->
        <receiver android:name=".ReviewWidget" android:exported="true" android:label="@string/r_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_review_info" />
        </receiver>

        <!-- widget «Ripasso rapido» (4×4): le carte da ripassare una alla volta, senza aprire l'app; i voti vanno in coda e li applica l'app.
             Non esportato: i tocchi arrivano solo dai PendingIntent del widget -->
        <receiver android:name=".ReviewBigWidget" android:exported="false" android:label="@string/rb_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_review_big_info" />
        </receiver>

        <service android:name=".MusicService" android:exported="false" android:foregroundServiceType="mediaPlayback" />

        <receiver android:name=".Reminder" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- per condividere il file di backup (Android 8 e 9, dove non si scrive direttamente in Download) -->
        <provider
            android:name=".ShareProvider"
            android:authorities="it.mandarino.app.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
